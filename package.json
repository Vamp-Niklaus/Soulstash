{
  "name": "soulstash-movie-app",
  "version": "3.0.0",
  "description": "Movie streaming app with collections",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "vite build --configLoader native",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server.js",
    "dev:client": "vite --configLoader native",
    "dev:full": "npm run dev",
    "render-build": "npm run build",
    "desktop": "tauri",
    "desktop:build": "tauri build --bundles nsis"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-query-persist-client": "^5.105.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@videojs/react": "^10.0.0-beta.5",
    "acorn": "^8.16.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "fetch": "^1.1.0",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.1.0",
    "idb-keyval": "^6.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.0",
    "playwright": "^1.59.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.1",
    "react-masonry-css": "^1.0.16",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.10.1",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.7",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
